# Thought → Speak — production settings for the free public beta.
# setup.sh copies this to /etc/thought-to-speak/env (only if that file doesn't exist yet). Edit it there, then:
#   sudo systemctl restart thought-to-speak

# ---- free beta: built-in coach only, no paid APIs ----
LLM_PROVIDER=local
TRANSCRIBE_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- accounts and beta limits ----
AUTH_MODE=accounts
BETA=1
# Max accounts while the beta is on a free server (0 = no cap). Raise it as the server copes.
BETA_MAX_USERS=200
# Max analyzed takes per person per day.
DAILY_TAKE_LIMIT=30
FEEDBACK_URL=https://github.com/Gayathri2016/thought-to-speak/issues
# Shown on the privacy page if set.
CONTACT_EMAIL=

# ---- running behind Caddy (HTTPS) ----
COOKIE_SECURE=1
API_DOCS=0
SECURITY_HEADERS=1

# ---- storage (on the server's disk; backed up nightly) ----
TTS_DB_PATH=/var/lib/thought-to-speak/thought_to_speak.db
TTS_AUDIO_DIR=/var/lib/thought-to-speak/audio
TTS_TMP_DIR=/var/lib/thought-to-speak/tmp

# ---- analysis jobs ----
# 2 for the Ampere (ARM) free server; 1 for the 1 GB AMD micro server (setup.sh picks this for you).
ANALYSIS_WORKERS=2
JOB_MAX_TRIES=3
MAX_AUDIO_SECONDS=300
