# Caddy — HTTPS in front of the app, with a free Let's Encrypt certificate that Caddy renews by itself.
# setup.sh writes this to /etc/caddy/Caddyfile with your domain filled in.
__DOMAIN__ {
	encode zstd gzip
	# recordings are uploaded as WAV; the app applies its own, smaller limit
	request_body {
		max_size 30MB
	}
	reverse_proxy 127.0.0.1:8000
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
