# Which engine analyzes your speech: auto | openai | anthropic | local
#   auto = OpenAI if OPENAI_API_KEY is set, else Anthropic, else Groq (free open-weight models) if GROQ_API_KEY is set,
#          else local heuristics
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

ANTHROPIC_API_KEY=
# Free tier at console.groq.com (gpt-oss-120b + Whisper). Daily caps fall back to the built-in coach.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_TAKES=300
ANTHROPIC_MODEL=claude-sonnet-5-5

LLM_TIMEOUT_SECONDS=60
# TTS_DB_PATH=data/thought_to_speak.db

# Recording transcription (requests um/uh preservation; recognition can still omit them):
#   auto  = OpenAI Whisper API if OPENAI_API_KEY is set, else Groq Whisper if GROQ_API_KEY is set,
#           else local faster-whisper if installed, else browser only
TRANSCRIBE_PROVIDER=auto
TRANSCRIBE_DAILY=500
OPENAI_TRANSCRIBE_MODEL=whisper-1
WHISPER_LOCAL_MODEL=base.en
# TTS_AUDIO_DIR=data/audio

# ---- Accounts (v6) ----
# accounts = sign-in required, each user sees only their own practice (use this for a public website)
# single   = no sign-in; everything belongs to one local user (personal use on localhost)
AUTH_MODE=accounts
# Max analyzed takes per user per day — each costs a transcription + an LLM call. 0 = unlimited.
DAILY_TAKE_LIMIT=60
# HTTPS-only session cookie: auto = when the request is HTTPS. Behind a TLS-terminating proxy set 1.
COOKIE_SECURE=auto

# ---- Analysis jobs (v8.4) ----
# Background worker threads inside the app process (keep 1–2 on small hosts; run a single uvicorn worker).
ANALYSIS_WORKERS=2
# A job interrupted by a crash/restart is re-run up to this many times, then failed (and refunded).
JOB_MAX_TRIES=3
# How long /api/analyze and /api/analyze-audio wait for a result before answering 202 with the job.
JOB_WAIT_SECONDS=180
# Upload limits: bytes read before rejecting, and the decoded recording's maximum length.
MAX_AUDIO_BYTES=26214400
MAX_AUDIO_SECONDS=600
# Temporary audio not referenced by a pending job is deleted after this many seconds.
TMP_RETENTION_SECONDS=3600
# TTS_TMP_DIR=data/tmp

# ---- Public beta (v9) ----
# BETA=1 shows the beta badge and feedback link. BETA_MAX_USERS caps sign-ups (0 = no cap).
BETA=0
BETA_MAX_USERS=0
# Guests can try the app without an account (deleted after 14 days unless they sign up). 0 turns it off.
GUEST_MODE=1
GUEST_TAKE_LIMIT=3
FEEDBACK_URL=https://github.com/Gayathri2016/thought-to-speak/issues
CONTACT_EMAIL=
# API docs at /docs: on for local development, API_DOCS=0 on a public server.
API_DOCS=1
# Content-Security-Policy and other security headers on every response.
SECURITY_HEADERS=1
