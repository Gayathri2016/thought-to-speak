# Which engine analyzes your speech: auto | openai | anthropic | local
#   auto = OpenAI if OPENAI_API_KEY is set, else Anthropic if its key is set, else local heuristics
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

LLM_TIMEOUT_SECONDS=60
# TTS_DB_PATH=data/thought_to_speak.db

# Verbatim transcription of your recording (keeps um/uh, gives word timestamps for pause context):
#   auto  = OpenAI Whisper API if OPENAI_API_KEY is set, else local faster-whisper if installed, else browser only
TRANSCRIBE_PROVIDER=auto
OPENAI_TRANSCRIBE_MODEL=whisper-1
WHISPER_LOCAL_MODEL=base.en
# TTS_AUDIO_DIR=data/audio

# ---- Accounts (v6) ----
# accounts = sign-in required, each user sees only their own practice (use this for a public website)
# single   = no sign-in; everything belongs to one local user (personal use on localhost)
AUTH_MODE=accounts
# Max analyzed takes per user per day — each costs a transcription + an LLM call. 0 = unlimited.
DAILY_TAKE_LIMIT=60
# HTTPS-only session cookie: auto = when the request is HTTPS. Behind a TLS-terminating proxy set 1.
COOKIE_SECURE=auto
